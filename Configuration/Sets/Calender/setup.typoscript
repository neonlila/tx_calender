plugin.tx_txcalender_eventlist {
    view {
        templateRootPaths {
            10 = EXT:tx_calender/Resources/Private/Templates/
        }
        partialRootPaths {
            10 = EXT:tx_calender/Resources/Private/Partials/
        }
        layoutRootPaths {
            10 = EXT:tx_calender/Resources/Private/Layouts/
        }
    }
    persistence {
        storagePid = {$plugin.tx_calender.persistence.storagePid}
    }
    settings {
        itemsPerPage = 15
    }
}

tt_content.list.20.tx_txcalender_eventlist = USER
tt_content.list.20.tx_txcalender_eventlist {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    extensionName = TxCalender
    pluginName = EventList
    vendorName = Neon
}